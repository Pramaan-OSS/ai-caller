# Paste your key. This is the only value you set.
PRAMAAN_API_KEY=

# Optional. Leave these commented. The app runs without them.
# Signed callbacks use the endpoint secret from your account.
# PRAMAAN_WEBHOOK_SECRET=
# The client already uses https://api.pramaan.dev.
# PRAMAAN_BASE_URL=
# Public https address of this app. A local address is left unset.
# APP_URL=
# Comma-separated emails. Empty allows any signed-in account.
# ALLOWED_SIGN_IN=
